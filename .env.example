# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never exposed to the client bundle)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Token encryption (AES-256-GCM key, base64, 32 bytes)
TOKEN_ENCRYPTION_KEY=

# Cron / webhook auth
CRON_SECRET=

# Auth allowlist
ALLOWED_EMAIL=

# Public demo account (optional — unset disables the VIEW DEMO button and
# keeps the app owner-only). Set BOTH or NEITHER: email alone allowlists an
# address nobody can authenticate as (button needs both to render).
# Password: long random, e.g.
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Provision/reset with: npm run demo:reset
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Repo mode: "local" (Phase-1 localStorage repo) | "supabase"
NEXT_PUBLIC_REPO_MODE=local

# Whoop OAuth (developer app)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Strava OAuth (API app)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Strava webhook subscription id — NOT known upfront; set this after running
# `npm run strava:register-webhook` (it prints the id on success).
STRAVA_SUBSCRIPTION_ID=

# Public app URL (OAuth redirects, webhook registration)
NEXT_PUBLIC_APP_URL=
